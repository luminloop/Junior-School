    {
      "fieldname": "preview_info",
      "fieldtype": "HTML",
      "label": "Preview Info",
      "options": "<div class=\"alert alert-info\">\n<h5>Available Template Variables:</h5>\n<ul>\n<li><strong>{{ student_name }}</strong> - Student's full name</li>\n<li><strong>{{ student }}</strong> - Student ID</li>\n<li><strong>{{ program }}</strong> - Program/Class name</li>\n<li><strong>{{ company }}</strong> - School name</li>\n<li><strong>{{ company_logo }}</strong> - School logo URL</li>\n<li><strong>{{ academic_year }}</strong> - Academic year</li>\n<li><strong>{{ academic_term }}</strong> - Academic term</li>\n<li><strong>{{ date }}</strong> - Certificate date</li>\n<li><strong>{{ award_title }}</strong> - Award/Achievement title</li>\n<li><strong>{{ description }}</strong> - Award description</li>\n<li><strong>{{ principal_name }}</strong> - Principal name</li>\n<li><strong>{{ principal_signature }}</strong> - Principal signature image URL</li>\n<li><strong>{{ class_teacher }}</strong> - Class teacher name</li>\n<li><strong>{{ rubber_stamp }}</strong> - School stamp image URL</li>\n<li><strong>{{ certificate_number }}</strong> - Unique certificate number</li>\n</ul>\n<h5>Example Structure:</h5>\n<pre>\n&lt;div class=\"certificate\"&gt;\n  &lt;div class=\"header\"&gt;\n    &lt;img src=\"{{ company_logo }}\" /&gt;\n    &lt;h1&gt;{{ company }}&lt;/h1&gt;\n  &lt;/div&gt;\n  &lt;div class=\"body\"&gt;\n    &lt;h2&gt;Certificate of {{ certificate_type }}&lt;/h2&gt;\n    &lt;p&gt;This is to certify that&lt;/p&gt;\n    &lt;h3&gt;{{ student_name }}&lt;/h3&gt;\n    &lt;p&gt;{{ description }}&lt;/p&gt;\n  &lt;/div&gt;\n  &lt;div class=\"footer\"&gt;\n    &lt;div class=\"signature\"&gt;\n      &lt;img src=\"{{ principal_signature }}\" /&gt;\n      &lt;p&gt;{{ principal_name }}&lt;/p&gt;\n    &lt;/div&gt;\n  &lt;/div&gt;\n&lt;/div&gt;\n</pre>\n</div>"
    }
