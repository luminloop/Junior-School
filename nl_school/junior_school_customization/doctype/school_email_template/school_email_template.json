      "options": "<div class=\"alert alert-info\">\n<h5>Available Template Variables:</h5>\n<h6>Common Variables:</h6>\n<ul>\n<li><strong>{{ student_name }}</strong> - Student's full name</li>\n<li><strong>{{ student }}</strong> - Student ID</li>\n<li><strong>{{ guardian_name }}</strong> - Guardian's name</li>\n<li><strong>{{ company }}</strong> - School name</li>\n<li><strong>{{ academic_year }}</strong> - Academic year</li>\n<li><strong>{{ academic_term }}</strong> - Academic term</li>\n<li><strong>{{ program }}</strong> - Program/Class name</li>\n</ul>\n<h6>Report Card Variables:</h6>\n<ul>\n<li><strong>{{ total_score }}</strong> - Total score</li>\n<li><strong>{{ grade }}</strong> - Overall grade</li>\n<li><strong>{{ rank }}</strong> - Class rank</li>\n<li><strong>{{ class_teacher }}</strong> - Class teacher name</li>\n</ul>\n<h6>Attendance Variables:</h6>\n<ul>\n<li><strong>{{ attendance_date }}</strong> - Date of attendance</li>\n<li><strong>{{ status }}</strong> - Present/Absent</li>\n</ul>\n<h6>Fee Variables:</h6>\n<ul>\n<li><strong>{{ amount_due }}</strong> - Amount due</li>\n<li><strong>{{ due_date }}</strong> - Payment due date</li>\n</ul>\n</div>"
